# xAI Grok API (required for AI features)
XAI_API_KEY=

# Model configuration
XAI_MODEL_CHAT=grok-4.1-fast
XAI_MODEL_INSIGHT=grok-4.1-fast

# Database
# Local SQLite (default):
DATABASE_URL=sqlite:///./data/wellness.db
# Supabase — copy URI from Project Settings → Database → Connection string → Transaction pooler (port 6543).
# Change postgresql:// to postgresql+psycopg://. Avoid db.xxx.supabase.co:5432 on Windows/campus networks (DNS issues).
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ElevenLabs voice (chat TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
VOICE_ENABLED=true
MAX_VOICE_CHARS=2500

# Logging
LOG_LEVEL=INFO

# Journal validation
MIN_JOURNAL_CHARS=10
MAX_JOURNAL_CHARS=5000

# Chat limits
DAILY_CHAT_TOKEN_BUDGET=8000
MAX_CHAT_TURNS=5

# LLM timeout (seconds)
LLM_TIMEOUT_SECONDS=30
